[Unit]
Description=fortix privileged VPN helper
After=network.target

[Service]
Type=simple
User=root
ExecStart="/usr/libexec/fortix/fortix-helper"
Restart=on-failure
RestartSec=3
RuntimeDirectory=fortix
RuntimeDirectoryMode=0755
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths="/var/lib/fortix/state" "/var/log/fortix" "/etc/fortix" -"/etc/resolver"
# NoNewPrivileges is deliberately omitted because pppd needs privileged execution.

[Install]
WantedBy=multi-user.target
