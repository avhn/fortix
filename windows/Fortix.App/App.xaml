<Application x:Class="Fortix.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fortix.App.Views"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextToVisibilityConverter x:Key="VisibleWhenText" />
    <views:InverseBooleanConverter x:Key="Not" />
    <views:CollapsedWhenTrueConverter x:Key="CollapsedWhen" />
    <Thickness x:Key="Gap">0,0,0,8</Thickness>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Margin" Value="0,2,0,6" />
    </Style>
    <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Note}">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,6" />
    </Style>
  </Application.Resources>
</Application>
