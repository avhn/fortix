<Window x:Class="Fortix.App.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortix" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Icon="/Assets/Fortix.ico">
  <StackPanel Margin="20">
    <TextBlock x:Name="Heading" Style="{StaticResource Heading}" Margin="0,0,0,8" />
    <TextBlock x:Name="Subject" TextWrapping="Wrap" Margin="{StaticResource Gap}" />

    <!-- Password or code: hidden entry, optional saving of passwords only. -->
    <StackPanel x:Name="CredentialPanel">
      <Label x:Name="SecretLabel" Target="{Binding ElementName=Secret}" Padding="0,0,0,4" />
      <PasswordBox x:Name="Secret" PasswordChanged="SecretChanged" Margin="{StaticResource Gap}" />
      <CheckBox x:Name="Remember" Content="Save the password in Credential _Manager after connecting" Margin="{StaticResource Gap}" />
    </StackPanel>

    <!-- Certificate: an explicit, independent fingerprint check before trusting. -->
    <StackPanel x:Name="CertificatePanel">
      <TextBlock TextWrapping="Wrap" Margin="{StaticResource Gap}"
                 Text="The certificate could not be verified. Compare this SHA-256 fingerprint with your administrator before trusting it." />
      <TextBlock x:Name="CertSubject" TextWrapping="Wrap" />
      <TextBlock x:Name="CertIssuer" TextWrapping="Wrap" Margin="{StaticResource Gap}" />
      <TextBox x:Name="Digest" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="{StaticResource Gap}"
               AutomationProperties.Name="SHA-256 fingerprint" />
      <CheckBox x:Name="Verified" Content="I _verified this fingerprint independently" Click="VerifiedChanged" Margin="{StaticResource Gap}" />
    </StackPanel>

    <TextBlock x:Name="Problem" Style="{StaticResource Warning}" AutomationProperties.LiveSetting="Assertive" />
    <DockPanel Margin="0,8,0,0">
      <Button x:Name="CancelButton" Content="Cancel and _disconnect" IsCancel="True" Click="CancelClick" Padding="12,4" DockPanel.Dock="Left" />
      <Button x:Name="Confirm" IsDefault="True" Click="ConfirmClick" Padding="12,4" HorizontalAlignment="Right" />
    </DockPanel>
  </StackPanel>
</Window>
